{
  "uid": "reactivks",
  "title": "ReactiVKS backend",
  "schemaVersion": 40,
  "panels": [
    {
      "id": 1,
      "title": "Доступность",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "up",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Отставание Kafka",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "kafka_consumergroup_lag",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Ошибки задач",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "rate(job_runs_total{result=\"error\"}[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Длительность задач",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "rate(job_duration_seconds_sum[5m]) / rate(job_duration_seconds_count[5m])",
          "refId": "A"
        }
      ]
    }
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "5s"
}
