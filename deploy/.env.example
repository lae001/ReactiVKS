# Шаблон переменных окружения развертывания: cp deploy/.env.example deploy/.env и заполнить.
# deploy/.env в git не попадает. Для docker-compose.dev.yml файл не обязателен: у всех переменных
# есть значения по умолчанию для разработки. Для docker-compose.yml пароли и ключи LiveKit обязательны.

# --- PostgreSQL --------------------------------------------------------------
# Суперпользователь – только для инициализации тома и обслуживания.
POSTGRES_PASSWORD=
# Роли сервисов (docs/backend/database.md). Применяются только при создании тома:
# после смены пароля нужен ALTER ROLE или пересоздание тома.
AUTH_DB_PASSWORD=
MEETING_DB_PASSWORD=
ANALYTICS_DB_PASSWORD=

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=

# --- LiveKit -----------------------------------------------------------------
# Ключ и секрет Server API (секрет – не короче 32 символов). Те же значения – в .env meeting-service
# (LIVEKIT_API_KEY, LIVEKIT_API_SECRET), иначе LiveKit не примет выданные им токены.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# IP, который LiveKit сообщает клиентам; пусто – определяется автоматически.
# Для проверки со второго компьютера в локальной сети – IP этого компьютера в LAN.
LIVEKIT_NODE_IP=

# --- docker-compose.yml: система целиком --------------------------------------------------------------------
# development | production. production запрещает refresh-cookie без Secure (по http работает только localhost).
ENV=production
LOG_LEVEL=INFO
# Порт nginx на хосте: SPA и REST API – http://localhost:<порт>.
NGINX_HTTP_PORT=80
# Адрес фронтенда для ссылок-приглашений <PUBLIC_BASE_URL>/j/<код>.
PUBLIC_BASE_URL=http://localhost
# Адрес сигнализации LiveKit, который получает браузер участника (за nginx с TLS – wss://livekit.<домен>).
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# true – LiveKit определяет публичный IP через STUN (сервер в интернете); false – локальный адрес интерфейса.
LIVEKIT_USE_EXTERNAL_IP=false
# Порт meeting-service на 127.0.0.1 для вебхуков LiveKit (он в сети хоста). Свой, если 8002 занят.
MEETING_WEBHOOK_PORT=8002
# Открытая регистрация организаторов; false – учетные записи создает только администратор.
AUTH_REGISTRATION_ENABLED=true
# UID владельца deploy/secrets/jwt-private.pem: auth-service читает ключ под этим UID (id -u).
SECRETS_UID=1000
