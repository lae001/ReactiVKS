# Шаблон переменных окружения развертывания: cp deploy/.env.example deploy/.env и заполнить.
# deploy/.env в git не попадает. Для docker-compose.dev.yml файл не обязателен: у всех переменных
# есть значения по умолчанию для разработки.

# --- PostgreSQL --------------------------------------------------------------
# Суперпользователь – только для инициализации тома и обслуживания.
POSTGRES_PASSWORD=
# Роли сервисов (docs/backend/database.md). Применяются только при создании тома:
# после смены пароля нужен ALTER ROLE или пересоздание тома.
AUTH_DB_PASSWORD=
MEETING_DB_PASSWORD=
ANALYTICS_DB_PASSWORD=

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=

# --- LiveKit -----------------------------------------------------------------
# Ключ и секрет Server API (секрет – не короче 32 символов). Те же значения – в .env meeting-service
# (LIVEKIT_API_KEY, LIVEKIT_API_SECRET), иначе LiveKit не примет выданные им токены.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# IP, который LiveKit сообщает клиентам; пусто – определяется автоматически.
# Для проверки со второго компьютера в локальной сети – IP этого компьютера в LAN.
LIVEKIT_NODE_IP=
