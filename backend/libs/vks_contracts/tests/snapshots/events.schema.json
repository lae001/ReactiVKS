{
  "envelope": {
    "description": "Значение сообщения Kafka: метаданные и payload.\n\n``payload`` в конверте – словарь: модель payload выбирается по ``type`` и ``version`` (:func:`parse_event`).",
    "properties": {
      "correlation_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "request_id исходного запроса",
        "title": "Correlation Id"
      },
      "event_id": {
        "description": "UUIDv7 – для идемпотентной обработки",
        "format": "uuid",
        "title": "Event Id",
        "type": "string"
      },
      "occurred_at": {
        "format": "date-time",
        "title": "Occurred At",
        "type": "string"
      },
      "payload": {
        "additionalProperties": true,
        "title": "Payload",
        "type": "object"
      },
      "producer": {
        "examples": [
          "meeting-service"
        ],
        "minLength": 1,
        "title": "Producer",
        "type": "string"
      },
      "type": {
        "title": "Type",
        "type": "string"
      },
      "version": {
        "minimum": 1,
        "title": "Version",
        "type": "integer"
      }
    },
    "required": [
      "event_id",
      "type",
      "version",
      "occurred_at",
      "producer",
      "payload"
    ],
    "title": "EventEnvelope",
    "type": "object"
  },
  "events": {
    "consent.changed.v1": {
      "payload": {
        "properties": {
          "consent_state": {
            "enum": [
              "granted",
              "denied",
              "revoked",
              "not_required"
            ],
            "title": "Consent State",
            "type": "string"
          },
          "decided_at": {
            "format": "date-time",
            "title": "Decided At",
            "type": "string"
          },
          "meeting_id": {
            "format": "uuid",
            "title": "Meeting Id",
            "type": "string"
          },
          "notice_version": {
            "title": "Notice Version",
            "type": "string"
          },
          "participant_id": {
            "format": "uuid",
            "title": "Participant Id",
            "type": "string"
          }
        },
        "required": [
          "meeting_id",
          "participant_id",
          "consent_state",
          "notice_version",
          "decided_at"
        ],
        "title": "ConsentChanged",
        "type": "object"
      },
      "topic": "meeting.events"
    },
    "emotion.sample.v1": {
      "payload": {
        "$defs": {
          "EmotionProbabilities": {
            "description": "Сглаженные вероятности 7 классов.",
            "properties": {
              "angry": {
                "maximum": 1,
                "minimum": 0,
                "title": "Angry",
                "type": "number"
              },
              "disgust": {
                "maximum": 1,
                "minimum": 0,
                "title": "Disgust",
                "type": "number"
              },
              "fear": {
                "maximum": 1,
                "minimum": 0,
                "title": "Fear",
                "type": "number"
              },
              "happy": {
                "maximum": 1,
                "minimum": 0,
                "title": "Happy",
                "type": "number"
              },
              "neutral": {
                "maximum": 1,
                "minimum": 0,
                "title": "Neutral",
                "type": "number"
              },
              "sad": {
                "maximum": 1,
                "minimum": 0,
                "title": "Sad",
                "type": "number"
              },
              "surprise": {
                "maximum": 1,
                "minimum": 0,
                "title": "Surprise",
                "type": "number"
              }
            },
            "required": [
              "angry",
              "disgust",
              "fear",
              "happy",
              "sad",
              "surprise",
              "neutral"
            ],
            "title": "EmotionProbabilities",
            "type": "object"
          }
        },
        "description": "Отсчет распознавания по одному участнику. Без координат лица и без кадров (ADR-009).",
        "properties": {
          "confidence": {
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Confidence"
          },
          "dominant": {
            "anyOf": [
              {
                "enum": [
                  "angry",
                  "disgust",
                  "fear",
                  "happy",
                  "sad",
                  "surprise",
                  "neutral"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Dominant"
          },
          "face_box_area": {
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Доля площади кадра",
            "title": "Face Box Area"
          },
          "meeting_id": {
            "format": "uuid",
            "title": "Meeting Id",
            "type": "string"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "participant_id": {
            "format": "uuid",
            "title": "Participant Id",
            "type": "string"
          },
          "probs": {
            "anyOf": [
              {
                "$ref": "#/$defs/EmotionProbabilities"
              },
              {
                "type": "null"
              }
            ]
          },
          "raw_dominant": {
            "anyOf": [
              {
                "enum": [
                  "angry",
                  "disgust",
                  "fear",
                  "happy",
                  "sad",
                  "surprise",
                  "neutral"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "До сглаживания – для отладки качества",
            "title": "Raw Dominant"
          },
          "state": {
            "enum": [
              "analyzing",
              "no_face",
              "camera_off",
              "no_consent"
            ],
            "title": "State",
            "type": "string"
          },
          "ts": {
            "description": "Время получения кадра сервисом",
            "format": "date-time",
            "title": "Ts",
            "type": "string"
          }
        },
        "required": [
          "meeting_id",
          "participant_id",
          "ts",
          "state",
          "probs",
          "model_version"
        ],
        "title": "EmotionSample",
        "type": "object"
      },
      "topic": "emotion.samples"
    },
