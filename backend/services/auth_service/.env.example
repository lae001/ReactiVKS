# Локальный запуск auth-service (из backend/): cp services/auth_service/.env.example services/auth_service/.env
# Все переменные – docs/backend/auth-service.md, раздел «Конфигурация».
ENV=development
LOG_LEVEL=INFO

# БД из deploy/docker-compose.dev.yml, роль сервиса auth_svc.
DATABASE_URL=postgresql+asyncpg://auth_svc:auth-dev-password@localhost:5432/vks

# Ключ подписи: make jwt-key. Путь – относительно backend/.
JWT_PRIVATE_KEY_PATH=secrets/jwt-private.pem

# Браузеры принимают Secure-cookie и от http://localhost, поэтому и локально true.
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REGISTRATION_ENABLED=true

# Брокер Kafka из deploy/docker-compose.dev.yml (события user.events). Без него события копятся в auth.outbox.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
