# Локальный запуск meeting-service (из backend/): cp services/meeting_service/.env.example services/meeting_service/.env
# Все переменные – docs/backend/meeting-service.md, раздел «Конфигурация».
ENV=development
LOG_LEVEL=INFO

# БД из deploy/docker-compose.dev.yml, роль сервиса meeting_svc.
DATABASE_URL=postgresql+asyncpg://meeting_svc:meeting-dev-password@localhost:5432/vks

# Публичные ключи auth-service (make run-auth).
JWKS_URL=http://127.0.0.1:8001/api/v1/auth/.well-known/jwks.json

# Адрес фронтенда для ссылок-приглашений.
PUBLIC_BASE_URL=http://localhost:5173

# LiveKit из deploy/docker-compose.dev.yml; ключи – те же, что у сервера (deploy/.env или значения по умолчанию).
LIVEKIT_URL=http://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-secret-change-me-0123456789abcdef

# Kafka из deploy/docker-compose.dev.yml (с хоста). Не задан – события копятся в outbox.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
