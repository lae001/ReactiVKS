# Адрес LiveKit для страницы-песочницы /dev/livekit (EMO-17).
# В рабочем сценарии адрес приходит от meeting-service вместе с токеном.
VITE_LIVEKIT_URL=ws://localhost:7880

# Куда pnpm dev проксирует /api (по умолчанию – локальный auth-service).
# Браузер при этом видит один origin (http://localhost:5173), поэтому cookie vks_refresh работает.
# Используется и скриптом pnpm gen:api (OpenAPI берется с этого адреса).
VITE_DEV_API_TARGET=http://127.0.0.1:8001

# Реализация слоя API meeting-service: mock (по умолчанию, данные в памяти вкладки) или http
# (настоящие сервисы через /api/v1: auth-service 8001 и meeting-service 8002).
VITE_API_MODE=mock

# Куда pnpm dev проксирует пути meeting-service (meetings, join, participants, settings, admin/meetings,
# admin/health). По умолчанию – 127.0.0.1:8002: make run-meeting или облегченный pnpm dev:api (dev-api/README.md).
VITE_DEV_MEETING_API_TARGET=http://127.0.0.1:8002
